# ===== Required =====
GUARDIAN_API_KEY=
ANTHROPIC_API_KEY=

# ===== LLM Configuration =====
LLM_PROVIDER=anthropic
MODEL_TUTOR=claude-3-haiku-20240307
MODEL_ROUTER=claude-3-haiku-20240307
MODEL_JUDGE=claude-3-haiku-20240307

# Rate limiting — min ms between LLM calls (Anthropic free tier: 5 RPM → 13000ms safe)
LLM_MIN_DELAY_MS=13000

# ===== Optional =====
# Tavily — enables autonomous web context lookup
TAVILY_API_KEY=

# Database — Vercel Postgres or any PostgreSQL
DATABASE_URL=

# Legacy — kept for backward compatibility
# GEMINI_API_KEY=
