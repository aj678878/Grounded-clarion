# Guardian Content API
GUARDIAN_API_KEY=
GUARDIAN_API_BASE_URL=https://content.guardianapis.com

# Google Gemini API
GEMINI_API_KEY=

# Vercel Postgres (optional for local dev — metrics won't persist without it)
DATABASE_URL=

# Web Search for enhanced chat context (optional)
# Supported providers: tavily, serpapi, none
# If set to "none" or left blank, the tutor uses article text only
# and labels any general background accordingly.
SEARCH_PROVIDER=none
SEARCH_API_KEY=
