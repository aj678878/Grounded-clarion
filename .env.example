# ===== Required =====
GUARDIAN_API_KEY=
ANTHROPIC_API_KEY=

# ===== LLM Configuration =====
LLM_PROVIDER=anthropic
MODEL_TUTOR=claude-haiku-4-5-20251001
MODEL_ROUTER=claude-haiku-4-5-20251001
MODEL_JUDGE=claude-haiku-4-5-20251001
MODEL_SYNTHESIS=claude-sonnet-4-6

# Rate limiting — min ms between LLM calls (Anthropic free tier: 5 RPM → 13000ms safe)
LLM_MIN_DELAY_MS=13000

# ===== Optional =====
# Tavily — enables autonomous web context lookup
TAVILY_API_KEY=

# Apify — used by Compare Sources paywall fallback
APIFY_TOKEN=

# Database — Vercel Postgres or any PostgreSQL
DATABASE_URL=

# Legacy — kept for backward compatibility
# GEMINI_API_KEY=
