# ===== Required =====
GUARDIAN_API_KEY=
ANTHROPIC_API_KEY=

# ===== LLM Configuration =====
LLM_PROVIDER=anthropic
MODEL_TUTOR=claude-haiku-4-5-20251001
MODEL_ROUTER=claude-haiku-4-5-20251001
MODEL_JUDGE=claude-haiku-4-5-20251001
MODEL_SYNTHESIS=claude-haiku-4-5-20251001

# Rate limiting — 0 disables per-call delays (default). Set to e.g. 13000 on Anthropic free tier (5 RPM).
LLM_MIN_DELAY_MS=0

# ===== Optional =====
# Tavily — enables autonomous web context lookup
TAVILY_API_KEY=

# Apify — used by Compare Sources paywall fallback
APIFY_TOKEN=

# Database — Vercel Postgres or any PostgreSQL
DATABASE_URL=

# Legacy — kept for backward compatibility
# GEMINI_API_KEY=
